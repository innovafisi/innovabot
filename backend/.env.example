# Plantilla de variables de entorno del backend.
# Copia este archivo a backend/.env y completa los valores.
# NUNCA commitees backend/.env (está en .gitignore); el repo es público.

# ---- MaaS (LLM principal, endpoint compatible con OpenAI) ----
MAAS_API_KEY=cambia-me
MAAS_BASE_URL=https://api-ap-southeast-1.modelarts-maas.com/openai/v1
MAIN_LLM_MODEL=deepseek-v4.1-flash

# ---- Ollama (light LM local) ----
OLLAMA_BASE_URL=http://localhost:11434
LIGHT_LLM_MODEL=qwen2.5:3b-instruct-q4_K_M
# Opcional: threads de inferencia. Déjalo sin definir en el ECS (4 vCPU
# uniformes, auto-detect correcto). En CPUs híbridos de desarrollo
# (P+E+LPE cores, ej. Intel Core Ultra) fíjalo al núm. de P-cores o la
# generación cae a ~0.2 tok/s.
# OLLAMA_NUM_THREADS=6

# ---- RDS PostgreSQL con pgvector (rds-innovabot, base rag_fisi) ----
DATABASE_URL=postgresql://usuario:clave@192.168.0.168:5432/rag_fisi

# ---- Telegram (bot creado con BotFather) ----
TELEGRAM_BOT_TOKEN=cambia-me
TELEGRAM_WEBHOOK_SECRET=cambia-me

# ---- CORS: origen del frontend en Vercel (separados por coma si hay varios) ----
CORS_ORIGINS=https://innovabot.vercel.app

# ---- Límites de uso (por usuario: user ID de Telegram / session ID web) ----
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_HOUR=30
MAX_QUERY_CHARS=500

# ---- Retrieval ----
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILITUD=0.55

# ---- Embeddings (ingesta y consultas usan el mismo modelo) ----
EMBEDDINGS_MODEL=intfloat/multilingual-e5-small

# ---- Ingesta (rutas relativas a backend/; opcionales, con defaults) ----
FAQS_MD=data/faqs.md
SECCIONES_PORTAL_YML=data/secciones_portal.yml
