# Backend de InnovaBot: FastAPI (API web + webhook Telegram + ingesta batch).
# La imagen incluye el extra [ingest] porque la ingesta corre en el mismo
# contenedor (`docker compose run ingest`).
# Imagen fijada por digest (tarea 6.3, 2026-10-31) para garantizar inmutabilidad
# del tag (OWASP LLM03). Para actualizar: obtener el nuevo digest del manifest
# list vía https://hub.docker.com/v2/repositories/library/python/tags/3.12-slim
# y reemplazar el hash a continuación.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

WORKDIR /srv

COPY backend/pyproject.toml ./
COPY backend/requirements.lock ./
COPY backend/app ./app
COPY backend/data ./data

# Dependencias base desde el lock con verificación de hashes (tarea 6.1).
# Esto instala las versiones fijadas y verifica integridad antes de continuar.
RUN pip install --no-cache-dir --require-hashes -r requirements.lock

# torch CPU-first: en Linux, PyPI sirve por defecto la variante CUDA de torch
# (~4 GB de paquetes nvidia-* para una GPU que no existe). Este proyecto es
# CPU-only por diseño (ECS sin GPU), así que se instala torch desde el índice
# CPU de PyTorch ANTES: pip lo ve satisfecho y salta los paquetes nvidia.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir ".[ingest]"

# Sin puertos publicados: en producción solo Caddy expone 80/443 y proxya a app.
EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
